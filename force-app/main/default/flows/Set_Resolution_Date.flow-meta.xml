    <assignments>
        <name>Set_Resolution_Date</name>
        <label>Set Resolution Date</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>$Record.Resolution_Date__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Current_Resolution_Date</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <description>Automatically sets the resolution date when a service request is marked Resolved.</description>
    <environments>Default</environments>
    <formulas>
        <name>Current_Resolution_Date</name>
        <dataType>DateTime</dataType>
        <expression>NOW()</expression>
    </formulas>
    <interviewLabel>Set Resolution Date {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Set Resolution Date</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
